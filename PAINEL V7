-- Utilitários de Interface
local function SafeParent(gui)
    local targets = {game:GetService("CoreGui"), LocalPlayer:WaitForChild("PlayerGui")}
    for _, target in pairs(targets) do
        pcall(function() gui.Parent = target end)
    end
end

local function MakeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- Lógica de Detecção de Papéis (Corrigida)
local function GetPlayerRole(player)
    if not player or not player.Character then return "Innocent" end
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    
    if char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then
        return "Murder"
    elseif char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    return "Innocent"
end

-- ESP Otimizado (Evita Memory Leak)
local function CreateESP(player)
    local function SetupHighlight(char)
        if not char then return end
        local highlight = char:FindFirstChild("DZ_ESP_Highlight") or Instance.new("Highlight")
        highlight.Name = "DZ_ESP_Highlight"
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0
        highlight.Parent = char
        
        local connection
        connection = RunService.Heartbeat:Connect(function()
            if not char or not char.Parent then connection:Disconnect() return end
            local role = GetPlayerRole(player)
            local enabled = false
            local color = Color3.new(1,1,1)
            
            if role == "Murder" and getgenv().DZ_ESP_Murder then enabled = true color = Theme.Murder
            elseif role == "Sheriff" and getgenv().DZ_ESP_Sheriff then enabled = true color = Theme.Sheriff
            elseif role == "Innocent" and getgenv().DZ_ESP_Inno then enabled = true color = Theme.Innocent end
            
            highlight.Enabled = enabled
            highlight.FillColor = color
            highlight.OutlineColor = Color3.new(1,1,1)
        end)
    end
    player.CharacterAdded:Connect(SetupHighlight)
    if player.Character then SetupHighlight(player.Character) end
end

local function GunESP()
    task.spawn(function()
        while task.wait(1) do
            if getgenv().DZ_ESP_Gun then
                for _, v in pairs(workspace:GetDescendants()) do
                    if (v.Name == "Gun" or v.Name == "DroppedGun") and v:IsA("BasePart") then
                        if not v:FindFirstChild("DZ_Highlight") then
                            local h = Instance.new("Highlight")
                            h.Name = "DZ_Highlight"
                            h.FillColor = Theme.Gun
                            h.OutlineColor = Color3.new(1,1,1)
                            h.Parent = v
                        end
                    end
                end
            else
                for _, v in pairs(workspace:GetDescendants()) do
                    if v.Name == "DZ_Highlight" then v:Destroy() end
                end
            end
        end
    end)
end

-- Silent Aim / Aimbot (Corrigido para Delta)
local function GetClosestPlayer()
    local closest = nil
    local dist = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen then
                local magnitude = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                if magnitude < dist then 
                    closest = player 
                    dist = magnitude 
                end
            end
        end
    end
    return closest
end

-- Hook Seguro para Delta
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if not checkcaller() and method == "FireServer" and getgenv().DZ_SilentAim then
        if self.Name:lower():find("shoot") or self.Name:lower():find("fire") then
            local target = GetClosestPlayer()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                args[1] = target.Character.Head.Position
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

-- Auto Gun Logic (Teleport Suave)
-- Auto Gun Logic (Teleport apenas se Sheriff estiver morto)
local function AutoGunLogic()
    task.spawn(function()
        while task.wait(0.5) do
            if getgenv().DZ_AutoGun then
                pcall(function()
                    local isSheriffAlive = false
                    for _, p in pairs(Players:GetPlayers()) do
                        if GetPlayerRole(p) == "Sheriff" then
                            isSheriffAlive = true
                            break
                        end
                    end

                    if not isSheriffAlive then
                        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if root then
                            for _, v in pairs(workspace:GetDescendants()) do
                                if (v.Name == "Gun" or v.Name == "DroppedGun") and v:IsA("BasePart") then
                                    root.CFrame = v.CFrame
                                    break
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)
end

